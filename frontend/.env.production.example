# ==============================================================================
# ZIBONBABA.COM — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.production on your deployment hosting (e.g. Vercel)
# Never commit the actual production .env with secret keys to Git.

# 1. APPLICATION & DOMAIN CONFIGURATION
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://zibonbaba.com
PORT=3000

# 2. DATABASE & POOLER CONFIGURATION (Supabase PostgreSQL 17)
# Use transaction pooler (port 6543) for serverless DATABASE_URL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use direct connection (port 5432) for DIRECT_URL during migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# 3. SUPABASE PUBLIC CREDENTIALS (Client storage & realtime)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"

# 4. CRYPTOGRAPHIC SECRETS (Generate with: openssl rand -base64 48)
# DO NOT USE THE DEFAULT DEV SECRET IN PRODUCTION
JWT_SECRET="[REPLACE_WITH_HIGH_ENTROPY_64_CHAR_RANDOM_SECRET_KEY]"

# 5. ONLINE PAYMENT GATEWAYS (Bangladesh)
PAYMENT_SANDBOX=false

# SSLCommerz (Visa, Mastercard, bKash, Nagad, Rocket, Cards)
SSLCOMMERZ_STORE_ID="[YOUR-SSLCOMMERZ-LIVE-STORE-ID]"
SSLCOMMERZ_STORE_PASS="[YOUR-SSLCOMMERZ-LIVE-STORE-PASSWORD]"

# bKash Direct Tokenized Checkout API
BKASH_APP_KEY="[YOUR-BKASH-APP-KEY]"
BKASH_APP_SECRET="[YOUR-BKASH-APP-SECRET]"
BKASH_USERNAME="[YOUR-BKASH-MERCHANT-USERNAME]"
BKASH_PASSWORD="[YOUR-BKASH-MERCHANT-PASSWORD]"

# 6. TRANSACTIONAL EMAIL (Resend or SendGrid)
RESEND_API_KEY="re_[YOUR-RESEND-API-KEY]"
EMAIL_FROM="Zibonbaba <no-reply@zibonbaba.com>"

# 7. TRANSACTIONAL SMS GATEWAYS (Bangladesh & International)
# Greenweb Bangladesh Gateway
GREENWEB_SMS_TOKEN="[YOUR-GREENWEB-API-TOKEN]"

# Twilio (Optional / International fallback)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# 8. ANALYTICS & MONITORING (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
