# ==============================================================================
# Zibonbaba - Supabase & Vercel Production Environment Configuration
# ==============================================================================

# 1. Supabase PostgreSQL Connection Pooler (Transaction Mode - Port 6543)
# Used for runtime queries in serverless functions (Vercel)
# Format: postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase Direct Database Connection (Port 5432)
# Used by Prisma CLI for migrations / schema pushing (`prisma db push`)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 3. Supabase Project API Credentials (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# 4. Authentication / Session Secret (Generate a secure random string or match Supabase JWT secret)
JWT_SECRET="zibonbaba_super_secure_jwt_session_secret_token_123"

# 5. Optional Backend API URL (if running express microservices alongside)
# BACKEND_URL="https://your-backend.railway.app"
